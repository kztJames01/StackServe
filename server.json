{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kztJames01/stackfit-mcp",
  "title": "StackFit MCP",
  "description": "Offline cloud stack advice with cited provider evidence, decimal estimates, and setup bundles.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/kztJames01/Stackfit",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/kztjames01/stackfit-mcp:0.1.0",
      "transport": { "type": "stdio" },
      "runtimeArguments": [
        { "type": "named", "name": "--rm" },
        { "type": "named", "name": "-i" },
        { "type": "named", "name": "--network", "value": "none" }
      ]
    }
  ]
}
