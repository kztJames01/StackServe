{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "recipe_id",
    "recipe_version",
    "catalog_version",
    "corpus_version",
    "stack_id",
    "files",
    "required_user_actions",
    "sources",
    "validation"
  ],
  "properties": {
    "status": {
      "enum": ["prepared", "configured", "deployment_verified"]
    },
    "recipe_id": {"type": "string", "minLength": 1},
    "recipe_version": {"type": "string", "minLength": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "stack_id": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_user_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "phase", "topic", "title", "detail", "sources", "gaps"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "phase": {
            "enum": [
              "provision",
              "configure",
              "migrate",
              "verify",
              "operate",
              "rollback",
              "teardown"
            ]
          },
          "topic": {
            "enum": [
              "provision",
              "least_privilege",
              "dns",
              "env_vars",
              "adapter_patch",
              "cors",
              "migration",
              "tls",
              "health_check",
              "upload_read",
              "os_patching",
              "backup_restore",
              "expiry_checks",
              "rollback",
              "teardown"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "items": {"$ref": "#/$defs/citation"}
          },
          "gaps": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/citation"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "secret_scan_clean",
        "traced_keys",
        "errors",
        "needs_verification"
      ],
      "properties": {
        "valid": {"type": "boolean"},
        "secret_scan_clean": {"type": "boolean"},
        "traced_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "key", "trace"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
              "trace": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "path", "line"],
                    "properties": {
                      "kind": {"const": "code_reference"},
                      "path": {"type": "string", "minLength": 1},
                      "line": {"type": "integer", "minimum": 1}
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "target_path", "note"],
                    "properties": {
                      "kind": {"const": "adapter_patch"},
                      "target_path": {"type": "string", "minLength": 1},
                      "note": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "subject", "message"],
            "properties": {
              "code": {
                "enum": [
                  "untraced_key",
                  "invalid_key_name",
                  "duplicate_key",
                  "unknown_role",
                  "secret_detected"
                ]
              },
              "subject": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        },
        "needs_verification": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "gap"],
            "properties": {
              "scope": {"type": "string", "minLength": 1},
              "gap": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_url", "verified_at", "note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https://"},
        "verified_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
