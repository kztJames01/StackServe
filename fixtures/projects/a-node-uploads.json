{
  "stack_id": "recipe-a/cloudflare-pages-free+render-web-starter-hobby+neon-free+cloudflare-r2-standard",
  "workload": {
    "runtime": "node",
    "db_engine": "postgresql",
    "residency": "any",
    "commercial_use": false,
    "sleep_tolerant": true,
    "backup_required": false,
    "storage_gb_month": 100,
    "egress_gb": 1000,
    "writes_month": 100000,
    "reads_month": 1000000,
    "requests_month": 2000000,
    "app_outbound_gb": 20,
    "db_gb": 0.5,
    "db_cu_hours": 60
  },
  "files": [
    {
      "path": "package.json",
      "content": "{\"dependencies\":{\"express\":\"4.21.2\",\"pg\":\"8.13.1\",\"@aws-sdk/client-s3\":\"3.700.0\"}}"
    },
    {
      "path": "src/db.js",
      "content": "import pg from 'pg';\nexport const pool = new pg.Pool({ connectionString: process.env.PG_URL });\n"
    },
    {
      "path": "src/storage.js",
      "content": "export const storageConfig = {\n  endpoint: process.env.R2_S3_ENDPOINT,\n  region: process.env.R2_S3_REGION,\n  bucket: process.env.UPLOADS_BUCKET,\n  accessKeyId: process.env.R2_KEY_ID,\n  secretAccessKey: process.env.R2_SECRET_KEY,\n};\n"
    },
    {
      "path": "src/server.js",
      "content": "export const allowedOrigin = process.env.FRONTEND_ORIGIN;\n"
    }
  ],
  "env_mapping": {
    "database_url": "PG_URL",
    "storage_endpoint": "R2_S3_ENDPOINT",
    "storage_region": "R2_S3_REGION",
    "storage_bucket": "UPLOADS_BUCKET",
    "storage_access_key_id": "R2_KEY_ID",
    "storage_secret_access_key": "R2_SECRET_KEY",
    "cors_origin": "FRONTEND_ORIGIN"
  },
  "adapter_patches": []
}
