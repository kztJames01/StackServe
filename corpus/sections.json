  {
    "id": "render-web-port",
    "source_url": "https://render.com/docs/web-services",
    "heading": "Port binding",
    "parent_context": "render / web-services / render-web",
    "text": "Render web services must listen on 0.0.0.0. Bind the public HTTP server to PORT; its default is 10000. Failure to detect a listening port causes deployment failure.",
