  {
    "id": "render-free-filesystem",
    "source_url": "https://render.com/docs/free",
    "heading": "Local files lost on redeploy",
    "parent_context": "render / web-services / render-free",
    "text": "A Render Free service uses an ephemeral filesystem. Local uploads and database files are lost when the service restarts, redeploys, or spins down; Free services cannot attach persistent disks.",
