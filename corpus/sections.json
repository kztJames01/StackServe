  {
    "id": "neon-roles-lifecycle",
    "source_url": "https://neon.com/docs/manage/roles",
    "heading": "Role privilege boundaries",
    "parent_context": "neon / postgresql / lifecycle",
    "text": "Console and API-created roles receive neon_superuser membership. SQL-created roles receive basic public-schema privileges and need explicit grants for required database objects. Use SQL for custom limited privileges; do not assume a console-created role is least privilege.",
