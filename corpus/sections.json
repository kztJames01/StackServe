    "id": "render-web-tls",
    "source_url": "https://render.com/docs/web-services",
    "heading": "Connecting from the public internet",
    "parent_context": "render / web-services / render-web",
    "text": "Render terminates HTTPS at its load balancer and forwards HTTP to the service. Public HTTP requests are redirected to HTTPS.",
